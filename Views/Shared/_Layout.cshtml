<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    <!-- Syncfusion ASP.NET MVC controls styles -->
    <link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/35.1.39/tailwind3.css" />
    <!-- Syncfusion ASP.NET MVC controls scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/35.1.39/dist/ej2.min.js"></script>
    <script>
    window.baseUrl = '@Url.Content("~/")';
    </script>
</head>
<body>

    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <span class="navbar-brand">
                    Approval workflow and compare in ASP-NET-MVC-DOCX-Editor
                </span>
            </div>
        </div>
    </div>

    <div class="body-content">
        @RenderBody()
    </div>

    @RenderSection("scripts", required: false)
    @Html.EJS().ScriptManager()

</body>
</html>
<style>
    body {
        padding-top: 0 !important;
    }

    .body-content {
        padding-top: 8px !important;
        margin-top: 0 !important;
    }
    .body-content {
        width: 100%;
        padding-left: 15px;
        padding-right: 15px;
    }
</style>